# ==============================================================================
# AWS Dynamic Student Portfolio - Environment Configuration Example
# Copy this file to '.env' and update with your actual AWS resource endpoints.
# DO NOT commit the actual '.env' file containing secrets to version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Amazon RDS - MySQL Database Credentials
# ------------------------------------------------------------------------------
DB_HOST=your-rds-endpoint.cxxxxx.us-east-1.rds.amazonaws.com
DB_NAME=student_portfolio
DB_USER=admin
DB_PASSWORD=YourSecurePasswordHere
DB_PORT=3306

# ------------------------------------------------------------------------------
# Amazon DynamoDB Configuration
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
DYNAMODB_TABLE=student_portfolio

# ------------------------------------------------------------------------------
# Application Environment
# Options: 'development' | 'production'
# When set to 'development', detailed error guidance is shown.
# ------------------------------------------------------------------------------
APP_ENV=production
